+<!DOCTYPE html>
+<html lang="ru">
+<head>
+<meta charset="UTF-8">
+<link rel="icon" type="image/x-icon" href="/favicon.ico">
+<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
+<meta name="viewport" content="width=device-width, initial-scale=1.0">
+<title>Реализация — ProLabSupport</title>
+<link rel="preconnect" href="https://fonts.googleapis.com">
+<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
+<style>
+*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
+:root{
+  --bg:#14171d;--panel:#1b1f27;--panel-h:#20242e;--line:#2a2f3a;--line-2:#363c49;
+  --text:#eef0f3;--text-dim:#8b93a3;--text-faint:#565d6b;
+  --brand:#C53B2F;--brand-h:#d94737;--signal:#35d0c0;--signal-dim:rgba(53,208,192,.35);
+  --warn:#e0a940;--danger:#ff5752;--ok:#3fd07a;
+  --font-display:'Space Grotesk',sans-serif;--font-body:'Inter',system-ui,sans-serif;--font-mono:'IBM Plex Mono',monospace;
+  --radius:12px;
+}
+html,body{height:100%;}
+body{font-family:var(--font-body);background:
+  radial-gradient(ellipse 900px 500px at 15% -10%, rgba(197,59,47,.06), transparent 60%),
+  radial-gradient(ellipse 700px 500px at 100% 0%, rgba(53,208,192,.05), transparent 55%),
+  var(--bg);color:var(--text);min-height:100vh;}
+
+/* Topbar */
+.topbar{display:flex;align-items:center;justify-content:space-between;padding:14px 26px;border-bottom:1px solid var(--line);}
+.brand{display:flex;align-items:center;gap:12px;}
+.brand a{color:var(--text-dim);text-decoration:none;font-size:13px;border:1px solid var(--line-2);border-radius:8px;padding:6px 11px;transition:.15s;}
+.brand a:hover{border-color:var(--signal);color:var(--text);}
+.brand-name{font-family:var(--font-display);font-weight:600;font-size:15px;}
+.brand-name b{color:var(--brand);}
+.brand-name span{color:var(--text-dim);font-weight:500;}
+.right{display:flex;align-items:center;gap:14px;}
+.clock{font-family:var(--font-mono);font-size:12.5px;color:var(--text-dim);}
+.userName{font-size:12.5px;color:var(--text-dim);}
+.userName b{color:var(--text);}
+.logout-btn{border:1px solid var(--line-2);background:transparent;color:var(--text-dim);font-family:var(--font-body);font-size:12px;font-weight:600;padding:6px 12px;border-radius:8px;cursor:pointer;transition:.15s;}
+.logout-btn:hover{border-color:var(--brand);color:var(--text);}
+.refresh-btn{border:1px solid var(--signal-dim);background:rgba(53,208,192,.08);color:var(--signal);font-family:var(--font-body);font-size:12px;font-weight:600;padding:6px 12px;border-radius:8px;cursor:pointer;transition:.15s;}
+.refresh-btn:hover{background:rgba(53,208,192,.16);}
+.refresh-btn:disabled{opacity:.55;cursor:default;}
+
+main{padding:20px 26px 60px;max-width:1560px;margin:0 auto;}
+.page-head{display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:16px;}
+h1{font-family:var(--font-display);font-size:22px;font-weight:600;}
+.asof{font-family:var(--font-mono);font-size:11.5px;color:var(--text-faint);}
+
+/* Filters */
+.filters{display:grid;grid-template-columns:repeat(6,1fr);gap:12px;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:14px 16px;margin-bottom:16px;}
+.filters label{display:block;font-size:10.5px;text-transform:uppercase;letter-spacing:.6px;color:var(--text-faint);margin-bottom:5px;font-weight:600;}
+.filters select,.filters input{width:100%;background:var(--bg);border:1px solid var(--line-2);color:var(--text);font-family:var(--font-body);font-size:13px;padding:8px 10px;border-radius:8px;outline:none;}
+.filters select:focus,.filters input:focus{border-color:var(--signal);}
+@media(max-width:1100px){.filters{grid-template-columns:repeat(3,1fr);}}
+@media(max-width:640px){.filters{grid-template-columns:repeat(2,1fr);}}
+
+/* Funnel */
+.funnel{display:grid;grid-auto-flow:column;grid-auto-columns:1fr;gap:12px;margin-bottom:14px;overflow-x:auto;}
+.fcell{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:14px 15px 13px;min-width:150px;position:relative;overflow:hidden;}
+.fcell .fname{font-size:12.5px;color:var(--text-dim);font-weight:600;margin-bottom:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
+.fcell .fbar{position:absolute;left:0;right:0;top:38px;height:3px;}
+.fcell .fsum{font-family:var(--font-display);font-size:19px;font-weight:600;letter-spacing:-.3px;}
+.fcell .fcount{font-family:var(--font-mono);font-size:12px;color:var(--text-faint);margin-top:2px;}
+.funnel-legend{font-family:var(--font-mono);font-size:11px;color:var(--text-faint);margin-bottom:20px;}
+
+/* Summary chips */
+.chips{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:18px;}
+.chip{display:flex;align-items:center;gap:7px;background:var(--panel);border:1px solid var(--line);border-radius:20px;padding:7px 14px;font-size:12.5px;color:var(--text-dim);cursor:pointer;transition:.15s;}
+.chip:hover{border-color:var(--line-2);}
+.chip.active{border-color:var(--signal);color:var(--text);}
+.chip b{color:var(--text);font-family:var(--font-mono);}
+.chip .dot{width:8px;height:8px;border-radius:50%;}
+
+/* Table */
+.tablewrap{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;}
+table{width:100%;border-collapse:collapse;font-size:12.5px;}
+thead th{text-align:left;padding:11px 12px;color:var(--text-faint);font-weight:600;font-size:10.5px;text-transform:uppercase;letter-spacing:.5px;border-bottom:1px solid var(--line);white-space:nowrap;position:sticky;top:0;background:var(--panel);z-index:1;}
+tbody td{padding:11px 12px;border-bottom:1px solid var(--line);vertical-align:top;}
+tbody tr.deal-row{cursor:pointer;transition:background .12s;}
+tbody tr.deal-row:hover{background:var(--panel-h);}
+.stage-pill{display:inline-block;padding:2px 9px;border-radius:6px;font-size:11px;font-weight:600;white-space:nowrap;}
+.mono{font-family:var(--font-mono);}
+.num{font-family:var(--font-mono);text-align:right;white-space:nowrap;}
+.dim{color:var(--text-dim);}
+.faint{color:var(--text-faint);}
+.title-cell{max-width:280px;}
+.title-cell .t{color:var(--text);line-height:1.35;}
+.title-cell .c{font-size:11px;color:var(--text-dim);margin-top:2px;}
+.flag{font-size:14px;}
+.diff-ok{color:var(--ok);font-weight:600;}
+.diff-bad{color:var(--danger);font-weight:600;}
+a.deal-link{color:var(--signal);text-decoration:none;}
+a.deal-link:hover{text-decoration:underline;}
+
+/* Drill-down */
+tr.detail-row td{background:#171b22;padding:0;border-bottom:1px solid var(--line);}
+.detail-inner{padding:16px 18px;display:grid;grid-template-columns:1.1fr 1fr 1.2fr;gap:20px;}
+@media(max-width:1000px){.detail-inner{grid-template-columns:1fr;}}
+.detail-inner h4{font-family:var(--font-display);font-size:12px;text-transform:uppercase;letter-spacing:.6px;color:var(--text-dim);margin-bottom:10px;}
+.proc{display:flex;align-items:center;gap:8px;padding:6px 0;font-size:12.5px;border-bottom:1px dashed var(--line);}
+.proc:last-child{border-bottom:none;}
+.proc .pdot{width:8px;height:8px;border-radius:50%;flex-shrink:0;}
+.proc .ptype{color:var(--text-dim);min-width:120px;}
+.proc .pstage{margin-left:auto;font-size:11px;color:var(--text-faint);}
+.task{display:flex;align-items:center;gap:8px;padding:6px 0;font-size:12.5px;border-bottom:1px dashed var(--line);}
+.task:last-child{border-bottom:none;}
+.task .tt{flex:1;}
+.task .tmeta{font-size:11px;color:var(--text-faint);white-space:nowrap;}
+.task.overdue .tt{color:var(--danger);}
+.cmt{padding:7px 0;border-bottom:1px dashed var(--line);font-size:12.5px;}
+.cmt:last-child{border-bottom:none;}
+.cmt .cmeta{font-family:var(--font-mono);font-size:10.5px;color:var(--text-faint);margin-bottom:2px;}
+.empty{color:var(--text-faint);font-size:12px;font-style:italic;}
+.loading{padding:14px;color:var(--text-dim);font-size:12.5px;}
+
+.notice{background:rgba(224,169,64,.1);border:1px solid rgba(224,169,64,.35);color:#f0cf8f;font-size:12px;padding:10px 14px;border-radius:10px;margin-bottom:14px;}
+.spin{display:inline-block;width:13px;height:13px;border:2px solid var(--line-2);border-top-color:var(--signal);border-radius:50%;animation:sp .8s linear infinite;vertical-align:-2px;margin-right:6px;}
+@keyframes sp{to{transform:rotate(360deg);}}
+</style>
+</head>
+<body>
+
+<div class="topbar">
+  <div class="brand">
+    <a href="/portal.html">← ЦУП</a>
+    <span class="brand-name"><b>Реализация</b> · <span>операционный контроль</span></span>
+  </div>
+  <div class="right">
+    <span class="clock" id="clock">—</span>
+    <button class="refresh-btn" id="refreshBtn" onclick="refreshData()">🔄 Обновить</button>
+    <span class="userName" id="userName"></span>
+    <button class="logout-btn" onclick="logout()">Выйти</button>
+  </div>
+</div>
+
+<main>
+  <div class="page-head">
+    <h1>Ход исполнения сделок</h1>
+    <span class="asof" id="asof"></span>
+  </div>
+
+  <div id="fieldsNotice"></div>
+
+  <div class="filters">
+    <div><label>Воронка</label><select id="fPipeline"></select></div>
+    <div><label>Стадия сделки</label><select id="fStage"><option value="all">Все</option></select></div>
+    <div><label>Отдел</label><select id="fDept"><option value="all">Все</option></select></div>
+    <div><label>Менеджер</label><select id="fManager"><option value="all">Все</option></select></div>
+    <div><label>Заказчик</label><input id="fCustomer" type="text" placeholder="поиск по названию…"></div>
+    <div><label>Год / Месяц</label>
+      <div style="display:flex;gap:6px;">
+        <select id="fYear" style="flex:1"></select>
+        <select id="fMonth" style="flex:1"><option value="all">Все</option></select>
+      </div>
+    </div>
+  </div>
+
+  <div class="funnel" id="funnel"></div>
+  <div class="funnel-legend">Сумма&nbsp;|&nbsp;Количество</div>
+
+  <div class="chips" id="chips"></div>
+
+  <div class="tablewrap">
+    <table>
+      <thead><tr>
+        <th></th><th>Стадия</th><th>Компания</th><th>№&nbsp;Договора&nbsp;|&nbsp;Название</th>
+        <th>Поставка<br>по договору</th><th>Отгрузка<br>от завода</th><th>Разн.</th>
+        <th>Менеджер</th><th>Инженер</th><th>Оплата<br>завод</th><th>Оплата<br>клиент</th>
+        <th class="num">Сумма</th>
+      </tr></thead>
+      <tbody id="tbody">
+        <tr><td colspan="12" class="loading"><span class="spin"></span>Загрузка…</td></tr>
+      </tbody>
+    </table>
+  </div>
+</main>
+
+<script>
+const MONTHS=['','Январь','Февраль','Март','Апрель','Май','Июнь','Июль','Август','Сентябрь','Октябрь','Ноябрь','Декабрь'];
+let BOARD=null, activeFlag=null;
+
+function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
+function fmtSum(n){return Math.round(n||0).toLocaleString('ru-RU');}
+function fmtDate(d){if(!d)return '';const p=String(d).slice(0,10).split('-');return p.length===3?`${p[2]}.${p[1]}.${p[0]}`:String(d);}
+
+async function logout(){await fetch('/auth/logout',{method:'POST'});location.href='/login.html';}
+
+function tickClock(){const n=new Date();const p=x=>String(x).padStart(2,'0');document.getElementById('clock').textContent=`${p(n.getHours())}:${p(n.getMinutes())}:${p(n.getSeconds())}`;}
+setInterval(tickClock,1000);tickClock();
+
+function getFilters(){
+  const q=new URLSearchParams();
+  const pipe=document.getElementById('fPipeline').value;
+  if(pipe!=='all')q.set('categories',pipe);
+  const st=document.getElementById('fStage').value; if(st!=='all')q.set('stage',st);
+  const dp=document.getElementById('fDept').value; if(dp!=='all')q.set('department',dp);
+  const mg=document.getElementById('fManager').value; if(mg!=='all')q.set('manager',mg);
+  const cu=document.getElementById('fCustomer').value.trim(); if(cu)q.set('customer',cu);
+  const yr=document.getElementById('fYear').value; if(yr!=='all')q.set('year',yr);
+  const mo=document.getElementById('fMonth').value; if(mo!=='all')q.set('month',mo);
+  return q.toString();
+}
+
+async function loadBoard(){
+  document.getElementById('tbody').innerHTML=`<tr><td colspan="12" class="loading"><span class="spin"></span>Загрузка…</td></tr>`;
+  try{
+    const r=await fetch('/api/operational/board?'+getFilters());
+    if(r.status===401){location.href='/login.html';return;}
+    const data=await r.json();
+    if(!data.ok){throw new Error(data.error||'Ошибка');}
+    BOARD=data;
+    renderNotice(data);
+    renderFunnel(data.funnel);
+    renderChips(data.summary);
+    populateOptions(data);
+    renderRows(data.rows);
+    renderAsOf(data);
+  }catch(e){
+    document.getElementById('tbody').innerHTML=`<tr><td colspan="12" class="loading">Не удалось загрузить: ${esc(e.message)}</td></tr>`;
+  }
+}
+
+function renderAsOf(d){
+  const el=document.getElementById('asof');
+  const ls=d.lastSync||{};
+  const src={boot:'старт сервера',nightly:'ночная сверка',manual:'вручную'}[ls.source]||ls.source||'';
+  const when=ls.lastFullSync?new Date(ls.lastFullSync).toLocaleString('ru-RU'):'ещё не синхронизировано';
+  el.textContent=`Кэш обновлён: ${when}${src?' · '+src:''} · сделок в базе: ${ls.dealCount??(d.rows?d.rows.length:0)}`;
+}
+
+async function refreshData(){
+  const btn=document.getElementById('refreshBtn');
+  const old=btn.textContent; btn.disabled=true; btn.textContent='⏳ Обновляю…';
+  try{
+    const r=await fetch('/api/operational/refresh?'+getFilters(),{method:'POST'});
+    if(r.status===401){location.href='/login.html';return;}
+    const data=await r.json();
+    if(!data.ok)throw new Error(data.error||'Ошибка');
+    BOARD=data;renderNotice(data);renderFunnel(data.funnel);renderChips(data.summary);populateOptions(data);renderRows(data.rows);renderAsOf(data);
+  }catch(e){ alert('Не удалось обновить: '+e.message); }
+  finally{ btn.disabled=false; btn.textContent=old; }
+}
+
+function renderNotice(d){
+  const missing=Object.entries(d.fieldsReady||{}).filter(([k,v])=>!v).map(([k])=>k);
+  const map={contractNo:'№ договора',deliveryByDate:'Поставка по договору',factoryShip:'Отгрузка от завода',payTermsFactory:'Оплата (завод)',payTermsClient:'Оплата (клиент)',engineerId:'Инженер',comment:'Коммент.'};
+  const rel=missing.filter(m=>map[m]);
+  document.getElementById('fieldsNotice').innerHTML = rel.length
+    ? `<div class="notice">Колонки пока пустые — не заданы коды полей Bitrix: ${rel.map(m=>esc(map[m])).join(', ')}. Запусти <b>discover-deal-fields.js</b> и пришли вывод, чтобы я их подключил.</div>` : '';
+}
+
+function renderFunnel(f){
+  const el=document.getElementById('funnel');
+  if(!f||!f.cells.length){el.innerHTML='';return;}
+  el.innerHTML=f.cells.map(c=>`
+    <div class="fcell">
+      <div class="fname" title="${esc(c.name)}">${esc(c.name)}</div>
+      <div class="fbar" style="background:${esc(c.color||'#35d0c0')}"></div>
+      <div class="fsum">${fmtSum(c.sum)}</div>
+      <div class="fcount">${c.count} шт.</div>
+    </div>`).join('');
+}
+
+function renderChips(s){
+  const el=document.getElementById('chips');
+  const chips=[
+    {key:null,label:'Все сделки',val:s.dealCount,dot:'var(--signal)'},
+    {key:'red',label:'Красный флаг',val:s.redFlag||0,dot:'var(--brand)'},
+    {key:'overdue',label:'Просрочена поставка',val:s.overdue,dot:'var(--danger)'},
+    {key:'overdue-task',label:'Просроч. задачи',val:s.overdueTask||0,dot:'#ff8a3d'},
+    {key:'open-proc',label:'Открытые процессы',val:s.openProc||0,dot:'#5ac8fa'},
+    {key:'stale',label:`Завис > 14 дн`,val:s.stale,dot:'var(--warn)'},
+    {key:'late-ship',label:'Отгрузка позже срока',val:s.lateShip,dot:'#c98bff'},
+  ];
+  el.innerHTML=chips.map(c=>`<div class="chip ${activeFlag===c.key?'active':''}" data-flag="${c.key||''}">
+    <span class="dot" style="background:${c.dot}"></span>${esc(c.label)} <b>${c.val}</b></div>`).join('');
+  el.querySelectorAll('.chip').forEach(ch=>ch.onclick=()=>{
+    const f=ch.dataset.flag||null; activeFlag=(activeFlag===f)?null:f;
+    renderChips(BOARD.summary); renderRows(BOARD.rows);
+  });
+}
+
+function populateOptions(d){
+  const setOpts=(id,items,cur)=>{
+    const sel=document.getElementById(id);const v=cur??sel.value;
+    sel.innerHTML='<option value="all">Все</option>'+items.map(i=>`<option value="${esc(i.id)}">${esc(i.name)}</option>`).join('');
+    sel.value=v||'all';
+  };
+  // Departments & managers come from the current result set
+  setOpts('fDept',(d.options.departments||[]));
+  setOpts('fManager',(d.options.managers||[]));
+  // Stage list only meaningful when a single pipeline is chosen
+  const stageSel=document.getElementById('fStage');const curStage=stageSel.value;
+  if(d.funnel.mode==='stages'){
+    stageSel.innerHTML='<option value="all">Все</option>'+d.funnel.cells.map(c=>`<option value="${esc(c.key)}">${esc(c.name)}</option>`).join('');
+    stageSel.value=curStage||'all';stageSel.disabled=false;
+  }else{stageSel.innerHTML='<option value="all">Все</option>';stageSel.value='all';stageSel.disabled=true;}
+}
+
+function flagIcon(flags){
+  if(flags.includes('red'))return '<span class="flag" title="Красный флаг">🚩</span>';
+  if(flags.includes('overdue'))return '<span class="flag" title="Просрочена поставка">🔴</span>';
+  if(flags.includes('overdue-task'))return '<span class="flag" title="Просроченные задачи">⏰</span>';
+  if(flags.includes('stale'))return '<span class="flag" title="Завис (нет движения)">🟠</span>';
+  if(flags.includes('late-ship'))return '<span class="flag" title="Отгрузка позже срока">⚠️</span>';
+  if(flags.includes('open-proc'))return '<span class="flag" title="Открытые смарт-процессы">🔧</span>';
+  return '';
+}
+
+function renderRows(rows){
+  let list=rows;
+  if(activeFlag)list=rows.filter(r=>r.flags.includes(activeFlag));
+  const tb=document.getElementById('tbody');
+  if(!list.length){tb.innerHTML=`<tr><td colspan="12" class="loading">Нет сделок по текущим фильтрам.</td></tr>`;return;}
+  tb.innerHTML=list.map(r=>{
+    const diff = r.diffDays==null?'' :
+      `<span class="${r.onTime?'diff-ok':'diff-bad'}">${r.onTime?'✓ ':''}${r.diffDays}</span>`;
+    return `<tr class="deal-row" data-id="${r.id}">
+      <td class="flag">${flagIcon(r.flags)}</td>
+      <td><span class="stage-pill" style="background:${esc(r.stageColor)}22;color:${esc(r.stageColor)};border:1px solid ${esc(r.stageColor)}55">${esc(r.stageName)}</span></td>
+      <td>${esc(r.company)||'<span class="faint">—</span>'}</td>
+      <td class="title-cell"><div class="t"><a class="deal-link" href="${r.url}" target="_blank" onclick="event.stopPropagation()">${esc(r.contractNo||('#'+r.id))}</a></div><div class="c">${esc(r.title)}</div></td>
+      <td class="mono ${r.flags.includes('overdue')?'diff-bad':'dim'}">${fmtDate(r.deliveryBy)}</td>
+      <td class="mono dim">${fmtDate(r.factoryShip)}</td>
+      <td class="num">${diff}</td>
+      <td>${esc(r.manager)||'<span class="faint">—</span>'}</td>
+      <td>${esc(r.engineer)||'<span class="faint">—</span>'}</td>
+      <td class="dim">${esc(r.payFactory)}</td>
+      <td class="dim">${esc(r.payClient)}</td>
+      <td class="num">${fmtSum(r.opportunity)}</td>
+    </tr>`;
+  }).join('');
+  tb.querySelectorAll('.deal-row').forEach(tr=>tr.onclick=()=>toggleDetail(tr,tr.dataset.id));
+}
+
+async function toggleDetail(tr,id){
+  const nxt=tr.nextElementSibling;
+  if(nxt&&nxt.classList.contains('detail-row')){nxt.remove();return;}
+  document.querySelectorAll('tr.detail-row').forEach(x=>x.remove());
+  const dr=document.createElement('tr');dr.className='detail-row';
+  dr.innerHTML=`<td colspan="12"><div class="loading"><span class="spin"></span>Загрузка деталей сделки #${id}…</div></td>`;
+  tr.after(dr);
+  try{
+    const r=await fetch('/api/operational/deal/'+id);
+    const d=await r.json();
+    if(!d.ok)throw new Error(d.error||'Ошибка');
+    dr.querySelector('td').innerHTML=renderDetail(d);
+  }catch(e){
+    dr.querySelector('td').innerHTML=`<div class="loading">Не удалось загрузить: ${esc(e.message)}</div>`;
+  }
+}
+
+function renderDetail(d){
+  const sem=s=>s==='S'?'var(--ok)':s==='F'?'var(--danger)':'var(--warn)';
+  const procs=d.children.length?d.children.map(c=>`
+    <div class="proc"><span class="pdot" style="background:${sem(c.semantics)}"></span>
+      <span class="ptype">${esc(c.entityName)}</span>
+      <a class="deal-link" href="${c.url}" target="_blank">#${esc(c.id)}</a>
+      <span class="pstage">${esc(c.stageName)}</span></div>`).join(''):'<div class="empty">Нет связанных процессов</div>';
+  const tasks=d.tasks.length?d.tasks.map(t=>`
+    <div class="task ${t.overdue?'overdue':''}"><span class="pdot" style="background:${t.done?'var(--ok)':t.overdue?'var(--danger)':'var(--warn)'}"></span>
+      <span class="tt">${esc(t.title)}</span>
+      <span class="tmeta">${esc(t.responsible)}${t.deadline?' · '+fmtDate(t.deadline):''}</span></div>`).join(''):'<div class="empty">Нет задач</div>';
+  const cmts=d.comments.length?d.comments.map(c=>`
+    <div class="cmt"><div class="cmeta">${fmtDate(c.date)} · ${esc(c.author)}</div>${esc(c.text)}</div>`).join(''):'<div class="empty">Нет комментариев</div>';
+  return `<div class="detail-inner">
+    <div><h4>Смарт-процессы</h4>${procs}</div>
+    <div><h4>Задачи</h4>${tasks}</div>
+    <div><h4>Комментарии</h4>${cmts}</div>
+  </div>`;
+}
+
+function initFilters(){
+  // Pipeline select
+  const pipe=document.getElementById('fPipeline');
+  pipe.innerHTML='<option value="all">Все воронки</option>';
+  // Years
+  const ys=document.getElementById('fYear');const now=new Date().getFullYear();
+  ys.innerHTML='<option value="all">Все</option>'+[now,now-1,now-2].map(y=>`<option value="${y}">${y}</option>`).join('');
+  const ms=document.getElementById('fMonth');
+  ms.innerHTML='<option value="all">Все</option>'+MONTHS.slice(1).map((m,i)=>`<option value="${i+1}">${m}</option>`).join('');
+  ['fPipeline','fStage','fDept','fManager','fYear','fMonth'].forEach(id=>document.getElementById(id).addEventListener('change',()=>{if(id==='fPipeline')document.getElementById('fStage').value='all';loadBoard();}));
+  let t;document.getElementById('fCustomer').addEventListener('input',()=>{clearTimeout(t);t=setTimeout(loadBoard,350);});
+}
+
+async function init(){
+  try{
+    const r=await fetch('/auth/me');
+    if(!r.ok){location.href='/login.html';return;}
+    const {user}=await r.json();
+    document.getElementById('userName').innerHTML=`<b>${esc(user.displayName)}</b>`;
+  }catch(e){location.href='/login.html';return;}
+  initFilters();
+  // Fill pipeline options after first board load supplies names
+  const r=await fetch('/api/operational/board?');
+  if(r.status===401){location.href='/login.html';return;}
+  const d=await r.json();
+  if(d.ok&&d.pipelines){
+    const pipe=document.getElementById('fPipeline');
+    pipe.innerHTML='<option value="all">Все воронки</option>'+Object.entries(d.pipelines).map(([id,n])=>`<option value="${id}">${esc(n)}</option>`).join('');
+    BOARD=d;renderNotice(d);renderFunnel(d.funnel);renderChips(d.summary);populateOptions(d);renderRows(d.rows);renderAsOf(d);
+  }
+}
+init();
+</script>
+</body>
+</html>
