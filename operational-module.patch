+      <td><span class="stage-pill" style="background:${esc(r.stageColor)}22;color:${esc(r.stageColor)};border:1px solid ${esc(r.stageColor)}55">${esc(r.stageName)}</span></td>
+      <td>${esc(r.company)||'<span class="faint">—</span>'}</td>
+      <td class="title-cell"><div class="t"><a class="deal-link" href="${r.url}" target="_blank" onclick="event.stopPropagation()">${esc(r.contractNo||('#'+r.id))}</a></div><div class="c">${esc(r.title)}</div></td>
+      <td class="mono ${r.flags.includes('overdue')?'diff-bad':'dim'}">${fmtDate(r.deliveryBy)}</td>
+      <td class="mono dim">${fmtDate(r.factoryShip)}</td>
+      <td class="num">${diff}</td>
+      <td>${esc(r.manager)||'<span class="faint">—</span>'}</td>
+      <td>${esc(r.engineer)||'<span class="faint">—</span>'}</td>
+      <td class="dim">${esc(r.payFactory)}</td>
+      <td class="dim">${esc(r.payClient)}</td>
+      <td class="num">${fmtSum(r.opportunity)}</td>
+    </tr>`;
+  }).join('');
+  tb.querySelectorAll('.deal-row').forEach(tr=>tr.onclick=()=>toggleDetail(tr,tr.dataset.id));
+}
+
+async function toggleDetail(tr,id){
+  const nxt=tr.nextElementSibling;
+  if(nxt&&nxt.classList.contains('detail-row')){nxt.remove();return;}
+  document.querySelectorAll('tr.detail-row').forEach(x=>x.remove());
+  const dr=document.createElement('tr');dr.className='detail-row';
+  dr.innerHTML=`<td colspan="12"><div class="loading"><span class="spin"></span>Загрузка деталей сделки #${id}…</div></td>`;
+  tr.after(dr);
+  try{
+    const r=await fetch('/api/operational/deal/'+id);
+    const d=await r.json();
+    if(!d.ok)throw new Error(d.error||'Ошибка');
+    dr.querySelector('td').innerHTML=renderDetail(d);
+  }catch(e){
+    dr.querySelector('td').innerHTML=`<div class="loading">Не удалось загрузить: ${esc(e.message)}</div>`;
+  }
+}
+
+function renderDetail(d){
+  const sem=s=>s==='S'?'var(--ok)':s==='F'?'var(--danger)':'var(--warn)';
+  const procs=d.children.length?d.children.map(c=>`
+    <div class="proc"><span class="pdot" style="background:${sem(c.semantics)}"></span>
+      <span class="ptype">${esc(c.entityName)}</span>
+      <a class="deal-link" href="${c.url}" target="_blank">#${esc(c.id)}</a>
+      <span class="pstage">${esc(c.stageName)}</span></div>`).join(''):'<div class="empty">Нет связанных процессов</div>';
+  const tasks=d.tasks.length?d.tasks.map(t=>`
+    <div class="task ${t.overdue?'overdue':''}"><span class="pdot" style="background:${t.done?'var(--ok)':t.overdue?'var(--danger)':'var(--warn)'}"></span>
+      <span class="tt">${esc(t.title)}</span>
+      <span class="tmeta">${esc(t.responsible)}${t.deadline?' · '+fmtDate(t.deadline):''}</span></div>`).join(''):'<div class="empty">Нет задач</div>';
+  const cmts=d.comments.length?d.comments.map(c=>`
+    <div class="cmt"><div class="cmeta">${fmtDate(c.date)} · ${esc(c.author)}</div>${esc(c.text)}</div>`).join(''):'<div class="empty">Нет комментариев</div>';
+  return `<div class="detail-inner">
+    <div><h4>Смарт-процессы</h4>${procs}</div>
+    <div><h4>Задачи</h4>${tasks}</div>
+    <div><h4>Комментарии</h4>${cmts}</div>
+  </div>`;
+}
+
+function initFilters(){
+  // Pipeline select
+  const pipe=document.getElementById('fPipeline');
+  pipe.innerHTML='<option value="all">Все воронки</option>';
+  // Years
+  const ys=document.getElementById('fYear');const now=new Date().getFullYear();
+  ys.innerHTML='<option value="all">Все</option>'+[now,now-1,now-2].map(y=>`<option value="${y}">${y}</option>`).join('');
+  const ms=document.getElementById('fMonth');
+  ms.innerHTML='<option value="all">Все</option>'+MONTHS.slice(1).map((m,i)=>`<option value="${i+1}">${m}</option>`).join('');
+  ['fPipeline','fStage','fDept','fManager','fYear','fMonth'].forEach(id=>document.getElementById(id).addEventListener('change',()=>{if(id==='fPipeline')document.getElementById('fStage').value='all';loadBoard();}));
+  let t;document.getElementById('fCustomer').addEventListener('input',()=>{clearTimeout(t);t=setTimeout(loadBoard,350);});
+}
+
+async function init(){
+  try{
+    const r=await fetch('/auth/me');
+    if(!r.ok){location.href='/login.html';return;}
+    const {user}=await r.json();
+    document.getElementById('userName').innerHTML=`<b>${esc(user.displayName)}</b>`;
+  }catch(e){location.href='/login.html';return;}
+  initFilters();
+  // Fill pipeline options after first board load supplies names
+  const r=await fetch('/api/operational/board?');
+  if(r.status===401){location.href='/login.html';return;}
+  const d=await r.json();
+  if(d.ok&&d.pipelines){
+    const pipe=document.getElementById('fPipeline');
+    pipe.innerHTML='<option value="all">Все воронки</option>'+Object.entries(d.pipelines).map(([id,n])=>`<option value="${id}">${esc(n)}</option>`).join('');
+    BOARD=d;renderNotice(d);renderFunnel(d.funnel);renderChips(d.summary);populateOptions(d);renderRows(d.rows);
+    document.getElementById('asof').textContent='По состоянию на '+new Date(d.generatedAt).toLocaleString('ru-RU');
+  }
+}
+init();
+</script>
+</body>
+</html>
